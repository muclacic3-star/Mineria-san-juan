{
  "name": "mineria-san-juan",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test --test-isolation=none tests/*.test.mjs tests/*.test.js",
    "dev": "pnpm build && wrangler dev --test-scheduled",
    "deploy": "pnpm build && wrangler deploy",
    "db:local": "wrangler d1 migrations apply mineria-san-juan --local",
    "db:remote": "wrangler d1 migrations apply mineria-san-juan --remote"
  },
  "devDependencies": {
    "wrangler": "4.129.0"
  }
}
